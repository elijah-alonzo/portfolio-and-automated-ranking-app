# Rebuilt inside the image
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/public/js/filament
/public/css/filament
/public/fonts/filament
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder
/bootstrap/cache/*.php

# Local state and secrets: never baked into the image
.env
.env.*
!.env.example
/database/*.sqlite
/storage/app/private/*
/storage/app/public/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/storage/*.key

# Not needed to run the app
.git
.github
/tests
/docs
phpunit.xml
phpstan.neon
.phpunit.cache
.phpunit.result.cache
desktop.ini
.DS_Store
